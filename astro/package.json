{
  "name": "gyutron-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify:handoff": "node ../scripts/agent-handoff.mjs --check",
    "verify:header": "node scripts/verify-header-equivalence.mjs",
    "verify:button-purple": "node scripts/verify-button-purple.mjs",
    "verify:css-version": "node scripts/verify-css-version.mjs",
    "verify:turnstile": "node scripts/verify-turnstile.mjs",
    "verify:scroll-chrome": "node scripts/verify-scroll-chrome.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:a11y-lite": "node scripts/verify-a11y-lite.mjs",
    "verify:content-icons": "node ../scripts/smoke-content-icons.mjs --scope brand",
    "verify:all": "npm run verify:handoff && npm run verify:header && npm run verify:button-purple && npm run verify:css-version && npm run verify:turnstile && npm run verify:scroll-chrome && npm run verify:sitemap && npm run verify:routes && npm run verify:seo && npm run verify:a11y-lite && npm run verify:content-icons && npm run verify:i18n"
  },
  "dependencies": {
    "astro": "5.18.2"
  }
}
