---
import { htmlLang, t, type Locale } from '../i18n';
import Header from '../components/Header.astro';
import ChatWidget from '../components/ChatWidget.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import { withVersion } from '../lib/cssVersion';

interface Props {
  locale: Locale;
  path: string; // canonical page path (no locale prefix), e.g. '/barcode-scanners.html'
  title: string;
  description: string;
  ogTitle?: string; // defaults to title when a page ships a distinct social title
  ogDescription?: string; // defaults to description
  bodyClass?: string;
  pageCss?: string[];
  structuredData?: unknown; // JSON-LD node or array; defaults to Organization in SeoHead
}
const { locale, path, title, description, ogTitle, ogDescription, bodyClass, pageCss = [], structuredData } = Astro.props;
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      locale={locale}
      path={path}
      title={title}
      description={description}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    {pageCss.map((href) => <link rel="stylesheet" href={withVersion(href)} />)}
    <link rel="stylesheet" href={withVersion('/nav-chrome.css')} />
    <link rel="stylesheet" href={withVersion('/chat-widget.css')} />
    {locale === 'ja' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <style is:global>{`
          body, button, input, select, textarea { font-family: "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Meiryo", system-ui, sans-serif; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
          body { line-height: 1.7; }
          h1, h2, h3, h4 { font-weight: 700; line-height: 1.45; }
          p, li, label, td { font-weight: 400; }
          .nav a, .nav-links a, .nav-trigger, .nav-item > a, .top-strip, .brand span { font-weight: 700; color: var(--ink, #17121f); }
          .nav, .nav-links, .nav a, .nav-links a, .nav-trigger { font-size: 15px; text-transform: none; letter-spacing: 0.01em; }
        `}</style>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <Header locale={locale} path={path} />
    <slot />
    <slot name="footer" />
    <ChatWidget locale={locale} />
    <button
      class="back-to-top"
      type="button"
      data-back-to-top
      aria-label={t(locale, 'site.backToTop')}
      title={t(locale, 'site.backToTop')}
      aria-hidden="true"
      tabindex="-1"
    >
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>
    <script src="/nav-search.js" is:inline></script>
    <script src="/mobile-navigation.js" is:inline></script>
    <script src="/chat-widget.js" is:inline></script>
    <script is:inline>
      /* Shared page chrome: directional header + accessible back-to-top control. */
      (() => {
        const root = document.body;
        const backToTop = document.querySelector('[data-back-to-top]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let lastY = window.pageYOffset || 0;
        let ticking = false;

        const setBackToTopVisible = (visible) => {
          if (!backToTop) return;
          backToTop.classList.toggle('is-visible', visible);
          backToTop.setAttribute('aria-hidden', String(!visible));
          backToTop.tabIndex = visible ? 0 : -1;
          if (!visible && document.activeElement === backToTop) backToTop.blur();
        };

        const update = () => {
          const y = window.pageYOffset || 0;
          if (Math.abs(y - lastY) > 5) {
            if (y > lastY && y > 130) root.classList.add('nav-hidden');
            else if (y < lastY) root.classList.remove('nav-hidden');
            lastY = y;
          }
          if (y <= 80) root.classList.remove('nav-hidden');
          setBackToTopVisible(y > 320);
          ticking = false;
        };

        const requestUpdate = () => {
          if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
        };

        window.addEventListener('scroll', () => {
          requestUpdate();
        }, { passive: true });

        backToTop?.addEventListener('click', () => {
          root.classList.remove('nav-hidden');
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        });

        window.addEventListener('pageshow', requestUpdate);
        setBackToTopVisible(lastY > 320);
      })();
    </script>
  </body>
</html>
