{
  "name": "gyutron-website",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "agent:status": "node scripts/agent-handoff.mjs",
    "agent:check": "node scripts/agent-handoff.mjs --check",
    "deploy:diff": "node scripts/public-sync-diff.mjs",
    "deploy:check": "node scripts/public-sync-diff.mjs --check",
    "deploy": "wrangler deploy --config wrangler.toml --assets ./public/",
    "i18n:build": "node scripts/block-legacy-main-i18n.mjs",
    "i18n:audit": "python tools/i18n-audit.py",
    "i18n:gate": "python tools/i18n_gate.py",
    "i18n:sync": "node scripts/block-legacy-main-i18n.mjs",
    "i18n:check": "python tools/i18n_validate.py",
    "i18n:check:strict": "python tools/i18n_validate.py --strict",
    "shop:check": "python tools/build_shop.py --check && node --check shop/shop.js && node --check shop/shop-i18n.js && node --check shop/checkout.js",
    "shop:build": "python tools/build_shop.py",
    "shop:verify": "npm run shop:check && node scripts/smoke-content-icons.mjs --scope shop && node scripts/smoke-shop.mjs"
  },
  "devDependencies": {
    "wrangler": "4.93.1"
  }
}
